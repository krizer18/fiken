    "Drag up or down on the wave to set the strength, then rest four fingers on the pads below": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag up or down on the wave to set the strength, then rest four fingers on the pads below"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra arriba o abajo sobre la onda para ajustar la intensidad y apoya cuatro dedos en las almohadillas de abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez de haut en bas sur l'onde pour régler l'intensité, puis posez quatre doigts sur les pastilles en dessous"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Welle nach oben oder unten ziehen, um die Stärke einzustellen, dann vier Finger auf die Felder darunter legen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina su o giù sull'onda per impostare l'intensità, poi appoggia quattro dita sui tamponi sotto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para cima ou para baixo na onda para ajustar a intensidade e apoie quatro dedos nas áreas abaixo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep omhoog of omlaag op de golf om de sterkte in te stellen en leg vier vingers op de vlakken eronder"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra opp eller ned på bølgen for å stille styrken, og legg fire fingre på putene under"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra upp eller ner på vågen för att ställa styrkan, vila sedan fyra fingrar på plattorna nedanför"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk op eller ned på bølgen for at indstille styrken, og læg fire fingre på puderne nedenfor"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä ylös tai alas aallolla säätääksesi voimakkuutta ja aseta neljä sormea alla oleville tyynyille"
          }
        }
      }
    },
