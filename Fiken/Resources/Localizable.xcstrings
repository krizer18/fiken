    "Tap anywhere to crack it. Shake to reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap anywhere to crack it. Shake to reset"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca en cualquier parte para agrietarlo. Agita para reiniciar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez n'importe où pour le fissurer. Secouez pour réinitialiser"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irgendwo tippen, um es zu zersplittern. Schütteln zum Zurücksetzen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ovunque per incrinarlo. Scuoti per azzerare"
          }
