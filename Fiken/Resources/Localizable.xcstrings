        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em qualquer lugar para rachar. Balance para zerar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik waar dan ook om het te breken. Schud om te wissen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk hvor som helst for å knuse det. Rist for å nullstille"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck var som helst för att spräcka det. Skaka för att nollställa"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk hvor som helst for at knuse det. Ryst for at nulstille"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta mistä tahansa halkaistaksesi. Ravista nollataksesi"
